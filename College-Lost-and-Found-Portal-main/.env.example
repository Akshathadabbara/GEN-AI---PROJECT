# Flask and Server
FLASK_DEBUG=0
PORT=5000

# SQLite Database Location
DATABASE_PATH=lost_found.db

# AI Matching Thresholds (0.0 to 1.0)
MATCH_THRESHOLD=0.28
STRONG_MATCH_THRESHOLD=0.65
POSSIBLE_MATCH_THRESHOLD=0.40

# Vector Database (ChromaDB)
CHROMA_PATH=chroma_data
CHROMA_COLLECTION=items_rag

# OpenAI LLM Integration (Required for Conversational AI Match Explanations)
# Store your OpenAI API key here. NEVER commit your actual key to Git or expose in frontend!
# If left empty, semantic vector search will still work and UI will display clear setup instructions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=10

# Optional Alternative LLM (Google Gemini)
GEMINI_API_KEY=
LLM_PROVIDER=openai

# Admin Authorization Key for Claim Reviews and Item Status Changes
ADMIN_KEY=campus_admin_secret_2026
