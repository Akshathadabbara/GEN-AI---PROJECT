# Flask and Server Configuration
FLASK_DEBUG=0
PORT=5000

# SQLite Database Location
DATABASE_PATH=lost_found.db

# AI Matching Thresholds (0.0 to 1.0)
MATCH_THRESHOLD=0.28
STRONG_MATCH_THRESHOLD=0.65
POSSIBLE_MATCH_THRESHOLD=0.40

# Vector Database (ChromaDB) Configuration
CHROMA_PATH=chroma_data
CHROMA_COLLECTION=items_rag

# Multi-LLM Provider Configuration ("gemini", "openrouter", "openai", "auto", or "none")
LLM_PROVIDER=auto
LLM_TIMEOUT=8

# Google Gemini API Configuration (Recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter API Configuration (Alternative Multi-Model Gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# OpenAI API Configuration (Alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=8

# Admin Authorization Key for Claim Reviews and Item Status Changes
ADMIN_KEY=campus_admin_secret_2026
