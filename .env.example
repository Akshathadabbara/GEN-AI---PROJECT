# Flask and Server
FLASK_DEBUG=0
PORT=5000

# SQLite Database Location
DATABASE_PATH=lost_found.db

# AI Matching Thresholds (0.0 to 1.0)
MATCH_THRESHOLD=0.28
STRONG_MATCH_THRESHOLD=0.65
POSSIBLE_MATCH_THRESHOLD=0.40

# LLM Explanation Service (Optional - works seamlessly offline if empty)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT=8

# Admin Authorization Key for Claim Reviews and Item Status Changes
ADMIN_KEY=campus_admin_secret_2026
